# AuraLoop Admin Environment Config Template
# Copy this file to .env and configure your secrets:
# cp .env.example .env

VITE_ADMIN_EMAIL=theavdeshjadon@gmail.com
VITE_ADMIN_PASSWORD=your_secure_admin_password
VITE_ADMIN_PASSWORD_ALT=your_alternate_admin_password

VITE_CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
