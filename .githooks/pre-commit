#!/bin/bash
# Pre-commit hook for AuraLoop:
# Automatically synchronizes versions across all platform files whenever you commit,
# simply by editing AuraLoop/VERSION!

ROOT_DIR="$(git rev-parse --show-toplevel)"

# Sync AuraLoop
if [ -f "$ROOT_DIR/AuraLoop/version.sh" ] && [ -f "$ROOT_DIR/AuraLoop/VERSION" ]; then
    bash "$ROOT_DIR/AuraLoop/version.sh" >/dev/null 2>&1 || true
    git add "$ROOT_DIR/AuraLoop/VERSION" \
            "$ROOT_DIR/AuraLoop/build-app.sh" \
            "$ROOT_DIR/AuraLoop/Sources/AuraLoopApp/Views/WhatsNewView.swift" 2>/dev/null || true
fi
