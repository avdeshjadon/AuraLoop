<UserControl
    x:Class="AuraLoop.Controls.PlayerBarControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:AuraLoop.Models"
    mc:Ignorable="d">

    <Border Background="#D00A0D14"
            BorderBrush="{StaticResource AuraLoopBorderBrush}"
            BorderThickness="1"
            CornerRadius="18"
            Padding="16,10">
        <Grid ColumnDefinitions="Auto,*,Auto">
            <!-- Active wallpaper info -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource AuraLoopSurfaceBrush}">
                    <FontIcon Glyph="&#xEC15;" Foreground="{StaticResource AuraLoopAccentBrush}" FontSize="18"/>
                </Border>
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock x:Name="TitleText" Text="Snowfall in Forest" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource AuraLoopForegroundBrush}"/>
                    <TextBlock x:Name="StatusText" Text="Live Wallpaper • 60 FPS • WorkerW Active" FontSize="11" Foreground="{StaticResource AuraLoopMutedBrush}"/>
                </StackPanel>
            </StackPanel>

            <!-- Center Playback Controls -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16" VerticalAlignment="Center">
                <Button x:Name="PlayPauseButton"
                        Width="38" Height="38"
                        CornerRadius="19"
                        Background="{StaticResource AuraLoopAccentBrush}"
                        BorderThickness="0"
                        Click="PlayPauseButton_Click">
                    <FontIcon x:Name="PlayPauseIcon" Glyph="&#xE769;" FontSize="14" Foreground="White"/>
                </Button>

                <Button Width="32" Height="32"
                        CornerRadius="16"
                        Background="Transparent"
                        BorderBrush="{StaticResource AuraLoopBorderBrush}"
                        Click="NextWallpaper_Click">
                    <FontIcon Glyph="&#xE893;" FontSize="12" Foreground="{StaticResource AuraLoopForegroundBrush}"/>
                </Button>
            </StackPanel>

            <!-- Right Options: Volume, Speed -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Background="Transparent" BorderThickness="0" Padding="4" Click="MuteToggle_Click">
                        <FontIcon x:Name="VolumeIcon" Glyph="&#xE74F;" FontSize="13" Foreground="{StaticResource AuraLoopMutedBrush}"/>
                    </Button>
                    <Slider x:Name="VolumeSlider" Width="80" Minimum="0" Maximum="100" Value="0" ValueChanged="VolumeSlider_ValueChanged"/>
                </StackPanel>

                <ComboBox x:Name="SpeedCombo" Width="80" SelectedIndex="1" SelectionChanged="SpeedCombo_SelectionChanged">
                    <ComboBoxItem Content="0.5x" />
                    <ComboBoxItem Content="1.0x" />
                    <ComboBoxItem Content="1.5x" />
                    <ComboBoxItem Content="2.0x" />
                </ComboBox>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
