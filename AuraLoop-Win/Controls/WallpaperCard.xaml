<UserControl
    x:Class="AuraLoop.Controls.WallpaperCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:AuraLoop.Models"
    mc:Ignorable="d">

    <Border Background="{StaticResource AuraLoopSurfaceBrush}"
            BorderBrush="{StaticResource AuraLoopBorderBrush}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="0"
            Margin="6">
        <Grid RowDefinitions="180,Auto">
            <!-- Thumbnail Image and Overlays -->
            <Grid Grid.Row="0">
                <Image Source="{x:Bind Item.ThumbnailUrl, Mode=OneWay}"
                       Stretch="UniformToFill" />
                <Border CornerRadius="16,16,0,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#40000000" Offset="0"/>
                            <GradientStop Color="#00000000" Offset="0.4"/>
                            <GradientStop Color="#B00A0D14" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- Quality Badge -->
                <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                        Margin="10"
                        Background="#80000000"
                        BorderBrush="#40FFFFFF"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="6,3">
                    <TextBlock Text="{x:Bind Item.QualityBadge, Mode=OneWay}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="White"/>
                </Border>

                <!-- Favorite Button -->
                <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="10"
                        Width="32" Height="32"
                        Padding="0"
                        CornerRadius="16"
                        Background="#80000000"
                        BorderBrush="#40FFFFFF"
                        BorderThickness="1"
                        Click="Favorite_Click">
                    <FontIcon Glyph="&#xE734;" FontSize="13" Foreground="#FF3B30"/>
                </Button>

                <!-- Quick Apply / Play Button in Center -->
                <Button HorizontalAlignment="Center" VerticalAlignment="Center"
                        Width="44" Height="44"
                        CornerRadius="22"
                        Background="{StaticResource AuraLoopAccentBrush}"
                        BorderThickness="0"
                        Click="Apply_Click">
                    <FontIcon Glyph="&#xE768;" FontSize="16" Foreground="White"/>
                </Button>

                <!-- Download Progress Bar (visible if downloading) -->
                <ProgressBar VerticalAlignment="Bottom"
                             Value="{x:Bind Item.DownloadProgress, Mode=OneWay}"
                             Maximum="100"
                             Foreground="{StaticResource AuraLoopAccentBrush}"
                             Height="3" />
            </Grid>

            <!-- Metadata info footer -->
            <Grid Grid.Row="1" Padding="12,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{x:Bind Item.Title, Mode=OneWay}"
                               FontWeight="SemiBold"
                               FontSize="14"
                               Foreground="{StaticResource AuraLoopForegroundBrush}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{x:Bind Item.Category, Mode=OneWay}"
                               FontSize="11"
                               Foreground="{StaticResource AuraLoopMutedBrush}"/>
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="{x:Bind Item.FormattedDuration, Mode=OneWay}"
                           FontSize="11"
                           Foreground="{StaticResource AuraLoopMutedBrush}"
                           VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
