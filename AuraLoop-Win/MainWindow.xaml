<Window
    x:Class="AuraLoop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource AuraLoopDarkBgBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDEBAR -->
        <Border Grid.Column="0" Background="#0C1322" BorderBrush="{StaticResource AuraLoopGlassStrokeBrush}" BorderThickness="0,0,1,0">
            <Grid Padding="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Branding Header -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="0,10,0,28">
                    <Image Source="/Assets/icon.png" Width="36" Height="36" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="AURALOOP" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AuraLoopInkBrush}" CharacterSpacing="120" />
                        <TextBlock Text="Live Wallpapers" FontSize="11" Foreground="{StaticResource AuraLoopAccentBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Navigation List -->
                <StackPanel Grid.Row="1" Spacing="6">
                    <Button x:Name="NavHome" Style="{StaticResource GlassPillButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="NavHome_Click">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE80F;" FontSize="15" Foreground="{StaticResource AuraLoopAccentBrush}"/>
                            <TextBlock Text="Home" FontSize="14" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="NavExplore" Style="{StaticResource GlassPillButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="NavExplore_Click">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE721;" FontSize="15" Foreground="{StaticResource AuraLoopMintBrush}"/>
                            <TextBlock Text="Explore" FontSize="14" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="NavLibrary" Style="{StaticResource GlassPillButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="NavLibrary_Click">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE8B9;" FontSize="15" Foreground="{StaticResource AuraLoopInkBrush}"/>
                            <TextBlock Text="Library" FontSize="14" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="NavFavorites" Style="{StaticResource GlassPillButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="NavFavorites_Click">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xEB51;" FontSize="15" Foreground="#FF6B8E"/>
                            <TextBlock Text="Favorites" FontSize="14" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="NavAerials" Style="{StaticResource GlassPillButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="NavAerials_Click">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE753;" FontSize="15" Foreground="#FFD60A"/>
                            <TextBlock Text="Apple Aerials" FontSize="14" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="NavAutomation" Style="{StaticResource GlassPillButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="NavAutomation_Click">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE756;" FontSize="15" Foreground="#BF5AF2"/>
                            <TextBlock Text="Automation" FontSize="14" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="NavSettings" Style="{StaticResource GlassPillButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="NavSettings_Click">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE713;" FontSize="15" Foreground="{StaticResource AuraLoopMutedBrush}"/>
                            <TextBlock Text="Settings" FontSize="14" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Bottom Status -->
                <Border Grid.Row="2" Background="#131C30" CornerRadius="12" Padding="12,10" BorderBrush="{StaticResource AuraLoopGlassStrokeBrush}" BorderThickness="1">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource AuraLoopMintBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Engine Active" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AuraLoopInkBrush}" />
                        </StackPanel>
                        <TextBlock Text="Direct3D 12 • 60 FPS • 0% CPU" FontSize="10" Foreground="{StaticResource AuraLoopMutedBrush}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- MAIN CONTENT AREA -->
        <ContentControl x:Name="MainContentFrame" Grid.Column="1" />
    </Grid>
</Window>
