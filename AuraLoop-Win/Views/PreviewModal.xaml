<ContentDialog
    x:Class="AuraLoop.Views.PreviewModal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Wallpaper Preview"
    PrimaryButtonText="Set as Wallpaper"
    CloseButtonText="Close"
    DefaultButton="Primary"
    mc:Ignorable="d">

    <StackPanel Spacing="14" Width="480">
        <Border Height="240" CornerRadius="14" Background="#0C1322" BorderBrush="{StaticResource AuraLoopBorderBrush}" BorderThickness="1">
            <Grid>
                <Image x:Name="PreviewImage" Stretch="UniformToFill"/>
                <Border Background="#40000000" CornerRadius="14">
                    <Button HorizontalAlignment="Center" VerticalAlignment="Center"
                            Width="52" Height="52" CornerRadius="26"
                            Background="{StaticResource AuraLoopAccentBrush}" BorderThickness="0">
                        <FontIcon Glyph="&#xE768;" FontSize="18" Foreground="White"/>
                    </Button>
                </Border>
            </Grid>
        </Border>

        <StackPanel Spacing="4">
            <TextBlock x:Name="TitleText" Text="Wallpaper Title" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AuraLoopForegroundBrush}"/>
            <TextBlock x:Name="AuthorText" Text="By AuraLoop Studio" FontSize="12" Foreground="{StaticResource AuraLoopMutedBrush}"/>
        </StackPanel>

        <Grid ColumnDefinitions="*,*,*">
            <Border Grid.Column="0" Background="{StaticResource AuraLoopSurfaceBrush}" CornerRadius="10" Padding="10" Margin="0,0,4,0">
                <StackPanel>
                    <TextBlock Text="RESOLUTION" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AuraLoopMutedBrush}"/>
                    <TextBlock x:Name="ResolutionText" Text="4K Ultra HD" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AuraLoopForegroundBrush}"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Background="{StaticResource AuraLoopSurfaceBrush}" CornerRadius="10" Padding="10" Margin="4,0,4,0">
                <StackPanel>
                    <TextBlock Text="FRAMERATE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AuraLoopMutedBrush}"/>
                    <TextBlock x:Name="FpsText" Text="60 FPS" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AuraLoopForegroundBrush}"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="{StaticResource AuraLoopSurfaceBrush}" CornerRadius="10" Padding="10" Margin="4,0,0,0">
                <StackPanel>
                    <TextBlock Text="FILE SIZE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AuraLoopMutedBrush}"/>
                    <TextBlock x:Name="FileSizeText" Text="95 MB" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AuraLoopForegroundBrush}"/>
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</ContentDialog>
