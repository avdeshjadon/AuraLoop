<UserControl
    x:Class="AuraLoop.Views.ExploreView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:AuraLoop.Models">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="20" Padding="28">
            
            <!-- Header with Search -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="320" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Explore Catalog" FontSize="26" FontWeight="Bold" Foreground="{StaticResource AuraLoopInkBrush}" />
                    <TextBlock Text="Browse high-definition video loops and download on demand." FontSize="13" Foreground="{StaticResource AuraLoopMutedBrush}" />
                </StackPanel>

                <!-- Search Input -->
                <TextBox Grid.Column="1" PlaceholderText="Search wallpapers, tags, authors…" 
                         Background="#131B2E" Foreground="{StaticResource AuraLoopInkBrush}" 
                         BorderBrush="{StaticResource AuraLoopGlassStrokeBrush}" CornerRadius="18" Padding="12,8" />
            </Grid>

            <!-- Category Pills -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Style="{StaticResource AccentPillButtonStyle}" Content="All" />
                <Button Style="{StaticResource GlassPillButtonStyle}" Content="Nature" />
                <Button Style="{StaticResource GlassPillButtonStyle}" Content="Space" />
                <Button Style="{StaticResource GlassPillButtonStyle}" Content="Cities" />
                <Button Style="{StaticResource GlassPillButtonStyle}" Content="Abstract" />
                <Button Style="{StaticResource GlassPillButtonStyle}" Content="Apple Aerials" />
            </StackPanel>

            <!-- Wallpaper Grid -->
            <GridView ItemsSource="{x:Bind Wallpapers}" SelectionMode="None" IsItemClickEnabled="True">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="models:WallpaperItem">
                        <Border Style="{StaticResource GlassCardStyle}" Width="280" Height="240" Margin="0,0,16,16" Padding="0">
                            <Grid>
                                <!-- Thumbnail -->
                                <Border CornerRadius="14" Background="#111827">
                                    <Image Source="{x:Bind ThumbnailUrl}" Stretch="UniformToFill" Opacity="0.8" />
                                </Border>

                                <!-- Top Badges -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Spacing="6">
                                    <Border Background="#CC090D16" CornerRadius="8" Padding="6,3">
                                        <TextBlock Text="{x:Bind QualityBadge, Mode=OneWay}" 
                                                   FontSize="10" FontWeight="Bold" Foreground="{StaticResource AuraLoopMintBrush}" />
                                    </Border>
                                    <Border Background="#CC090D16" CornerRadius="8" Padding="6,3">
                                        <TextBlock Text="{x:Bind Resolution}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AuraLoopAccentBrush}" />
                                    </Border>
                                </StackPanel>

                                <!-- Bottom Info Scrim -->
                                <Border CornerRadius="0,0,14,14" VerticalAlignment="Bottom" Height="86">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#00090D16" Offset="0" />
                                            <GradientStop Color="#F0090D16" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>

                                <!-- Content & Action -->
                                <Grid VerticalAlignment="Bottom" Padding="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{x:Bind Title}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AuraLoopInkBrush}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{x:Bind Author}" FontSize="11" Foreground="{StaticResource AuraLoopMutedBrush}"/>
                                    </StackPanel>

                                    <Button Grid.Column="1" Style="{StaticResource GlassPillButtonStyle}" Padding="10,4" CornerRadius="14" Click="ApplyItem_Click">
                                        <TextBlock Text="Apply" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AuraLoopAccentBrush}" />
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

        </StackPanel>
    </ScrollViewer>
</UserControl>
