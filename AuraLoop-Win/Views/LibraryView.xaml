<UserControl
    x:Class="AuraLoop.Views.LibraryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:AuraLoop.Models">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="24" Padding="28">
            
            <!-- Library Header & Metrics -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Your Library" FontSize="26" FontWeight="Bold" Foreground="{StaticResource AuraLoopInkBrush}" />
                    <TextBlock Text="Manage downloaded wallpapers and import your own video clips." FontSize="13" Foreground="{StaticResource AuraLoopMutedBrush}" />
                </StackPanel>

                <!-- Actions -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                    <Button Style="{StaticResource GlassPillButtonStyle}" Click="ImportVideo_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8B5;" FontSize="13" />
                            <TextBlock Text="Import Video" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Storage & Metric Banner -->
            <Border Style="{StaticResource GlassCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="STORAGE USED" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AuraLoopMutedBrush}" />
                        <TextBlock Text="420.5 MB" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AuraLoopAccentBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="WALLPAPERS STORED" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AuraLoopMutedBrush}" />
                        <TextBlock Text="5 Active Clips" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AuraLoopInkBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock Text="ROTATION TIMER" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AuraLoopMutedBrush}" />
                        <TextBlock Text="Every 15 Minutes" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AuraLoopMintBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Downloaded Items List -->
            <TextBlock Text="DOWNLOADED &amp; IMPORTED" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AuraLoopInkBrush}" Margin="4,0,0,0" />

            <ListView ItemsSource="{x:Bind DownloadedWallpapers}" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:WallpaperItem">
                        <Border Style="{StaticResource GlassCardStyle}" Margin="0,0,0,10" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Thumbnail -->
                                <Border Grid.Column="0" Width="56" Height="42" CornerRadius="8" Background="#111827">
                                    <Image Source="{x:Bind ThumbnailUrl}" Stretch="UniformToFill" />
                                </Border>

                                <!-- Details -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                                    <TextBlock Text="{x:Bind Title}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource AuraLoopInkBrush}" />
                                    <TextBlock Text="{x:Bind Category}" FontSize="12" Foreground="{StaticResource AuraLoopMutedBrush}" />
                                </StackPanel>

                                <!-- Action Buttons -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button Style="{StaticResource GlassPillButtonStyle}" Padding="10,4" Click="ApplyItem_Click">
                                        <TextBlock Text="Set Wallpaper" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AuraLoopAccentBrush}" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

        </StackPanel>
    </ScrollViewer>
</UserControl>
