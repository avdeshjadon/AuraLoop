<Page
    x:Class="AuraLoop.Views.AppleGalleryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:AuraLoop.Models"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="24" Padding="32">
            <!-- Header -->
            <StackPanel Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon Glyph="&#xE753;" Foreground="{StaticResource AuraLoopAccentBrush}" FontSize="24"/>
                    <TextBlock Text="Apple Aerial 4K Gallery"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="{StaticResource AuraLoopForegroundBrush}"/>
                </StackPanel>
                <TextBlock Text="Curated high-framerate dynamic drone aerials from macOS Sonoma &amp; Apple TV 4K."
                           FontSize="14"
                           Foreground="{StaticResource AuraLoopMutedBrush}"/>
            </StackPanel>

            <!-- Aerial Grid -->
            <GridView x:Name="AerialGridView" SelectionMode="None">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="models:AppleAerialEntry">
                        <Border Width="300" Height="220"
                                Background="{StaticResource AuraLoopSurfaceBrush}"
                                BorderBrush="{StaticResource AuraLoopBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Margin="8">
                            <Grid RowDefinitions="140,*">
                                <Image Grid.Row="0" Source="{x:Bind PreviewUrl}" Stretch="UniformToFill"/>
                                <Border Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                        Margin="10" Background="#80000000" CornerRadius="6" Padding="6,2">
                                    <TextBlock Text="{x:Bind Resolution}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                </Border>
                                <Grid Grid.Row="1" Padding="14,10" ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource AuraLoopForegroundBrush}"/>
                                        <TextBlock Text="{x:Bind Subcategory}" FontSize="11" Foreground="{StaticResource AuraLoopMutedBrush}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Width="32" Height="32" CornerRadius="16"
                                            Background="{StaticResource AuraLoopAccentBrush}" BorderThickness="0">
                                        <FontIcon Glyph="&#xE768;" FontSize="12" Foreground="White"/>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </StackPanel>
    </ScrollViewer>
</Page>
