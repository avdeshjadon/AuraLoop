<Page
    x:Class="AuraLoop.Views.AutomationEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:AuraLoop.Models"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="24" Padding="32">
            <!-- Header -->
            <StackPanel Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon Glyph="&#xE756;" Foreground="{StaticResource AuraLoopAccentBrush}" FontSize="24"/>
                    <TextBlock Text="Automation &amp; Schedules"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="{StaticResource AuraLoopForegroundBrush}"/>
                </StackPanel>
                <TextBlock Text="Configure intelligent transitions based on time of day, battery state, and running applications."
                           FontSize="14"
                           Foreground="{StaticResource AuraLoopMutedBrush}"/>
            </StackPanel>

            <!-- Rules List -->
            <ListView x:Name="RulesListView" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:AutomationRule">
                        <Border Background="{StaticResource AuraLoopSurfaceBrush}"
                                BorderBrush="{StaticResource AuraLoopBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="16,12"
                                Margin="0,4">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10" Background="#200A84FF" Margin="0,0,14,0">
                                    <FontIcon Glyph="&#xE823;" Foreground="{StaticResource AuraLoopAccentBrush}" FontSize="16"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource AuraLoopForegroundBrush}"/>
                                    <TextBlock Text="{x:Bind TriggerValue}" FontSize="12" Foreground="{StaticResource AuraLoopMutedBrush}"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="2" IsOn="{x:Bind IsEnabled, Mode=TwoWay}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Button HorizontalAlignment="Left"
                    Background="{StaticResource AuraLoopAccentBrush}"
                    Foreground="White"
                    CornerRadius="10"
                    Padding="18,10">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="12"/>
                    <TextBlock Text="Add Automation Rule" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </ScrollViewer>
</Page>
