<UserControl
    x:Class="AuraLoop.Views.FavoritesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:AuraLoop.Models">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="20" Padding="28">
            <TextBlock Text="Favorite Wallpapers" FontSize="26" FontWeight="Bold" Foreground="{StaticResource AuraLoopInkBrush}" />
            <TextBlock Text="Wallpapers you've hearted for fast access and rotation." FontSize="13" Foreground="{StaticResource AuraLoopMutedBrush}" />

            <!-- Favorites Grid -->
            <GridView ItemsSource="{x:Bind FavoriteWallpapers}" SelectionMode="None">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="models:WallpaperItem">
                        <Border Style="{StaticResource GlassCardStyle}" Width="280" Height="220" Margin="0,0,16,16" Padding="0">
                            <Grid>
                                <Border CornerRadius="14" Background="#111827">
                                    <Image Source="{x:Bind ThumbnailUrl}" Stretch="UniformToFill" Opacity="0.8" />
                                </Border>

                                <Border CornerRadius="0,0,14,14" VerticalAlignment="Bottom" Height="70">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#00090D16" Offset="0" />
                                            <GradientStop Color="#E6090D16" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>

                                <Grid VerticalAlignment="Bottom" Padding="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{x:Bind Title}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource AuraLoopInkBrush}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{x:Bind Category}" FontSize="12" Foreground="{StaticResource AuraLoopMutedBrush}"/>
                                    </StackPanel>

                                    <FontIcon Grid.Column="1" Glyph="&#xEB52;" Foreground="{StaticResource AuraLoopAccentBrush}" VerticalAlignment="Center" FontSize="16" />
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </StackPanel>
    </ScrollViewer>
</UserControl>
